# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (Phase 5 Item 65)
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/.next-e2e/
/.next-timing/
/out/

# production
/build
# worker bundle (npm run build:worker)
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database backups (contain real credentials/PII, never commit)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (claude.ai/design) — staged converter scripts, build output,
# and machine state; config.json/NOTES.md/conventions.md/previews/overrides
# are the durable, committed set and stay out of this list.
/.ds-sync/
/ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# local dev server output
.dev-server.log

# Local AI-assistant and design tooling (kept on developer machines only)
/.claude/
/.agents/
/.github/agents/
/.github/skills/
/.github/hooks/
/.impeccable/
/.design-sync/
/skills-lock.json

# Local design references and working notes (not part of the public repo)
/stitch_resource_file_manager/
/CLAUDE_DESIGN_PROMPT.md
/ACADEMY_CONTENT_SPEC.md
/Afoogy-DESIGN-Alexandria.md
/PERFORMANCE_*.md
