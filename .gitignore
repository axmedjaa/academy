# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (Phase 5 Item 65)
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/.next-e2e/
/.next-timing/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database backups (contain real credentials/PII, never commit)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (claude.ai/design) — staged converter scripts, build output,
# and machine state; config.json/NOTES.md/conventions.md/previews/overrides
# are the durable, committed set and stay out of this list.
/.ds-sync/
/ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
