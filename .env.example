# Copy this file to .env.local and fill in real values for your machine.
# .env.local is gitignored and must never be committed.

NODE_ENV=development

# Native Windows PostgreSQL (official installer), default port 5432.
DATABASE_URL=postgresql://postgres:123@localhost:5432/academy

# Memurai (Redis-protocol-compatible native Windows service), default port 6379.
# No Docker/containers are used anywhere in this project's local dev setup.
REDIS_URL=redis://localhost:6379

# Optional Argon2id cost params (PLAN.md: "cost params tunable via env").
# Uncomment to override the argon2 library's own secure defaults.
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# Optional session lifetime in days (PLAN.md never states a value). Default: 30.
# SESSION_DURATION_DAYS=30

# Optional /login rate limit (PLAN.md names the endpoint, not a threshold).
# Defaults: 5 attempts / 900 seconds, keyed per client IP.
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optional password-reset token lifetime in minutes. Default: 60.
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Optional /forgot-password rate limit, keyed per target email (not IP —
# see lib/auth/forgot-password-rate-limit.ts). Defaults: 5 / 900 seconds.
# FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# Required: 32-byte base64 AES-256 key used to encrypt TOTP secrets at rest
# (PLAN.md: "app-level encryption key via env, separate from password
# hashing"). Generate your own per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Optional /mfa/challenge rate limit (PLAN.md names the endpoint, not a
# threshold). Defaults: 5 attempts / 900 seconds, keyed per client IP.
# MFA_CHALLENGE_RATE_LIMIT_MAX_ATTEMPTS=5
# MFA_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS=900

# Optional TOTP enrollment-verification rate limit, keyed per userId (not
# IP — see lib/auth/mfa-enrollment-rate-limit.ts). Defaults: 5 attempts /
# 900 seconds.
# MFA_ENROLLMENT_RATE_LIMIT_MAX_ATTEMPTS=5
# MFA_ENROLLMENT_RATE_LIMIT_WINDOW_SECONDS=900

# Optional public /verify/[certificateCode] rate limit, keyed per client IP
# (PLAN.md names the endpoint, not a threshold — see
# lib/academies/certificate-verify-rate-limit.ts for the default/rationale).
# Defaults: 20 attempts / 600 seconds.
# CERTIFICATE_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=20
# CERTIFICATE_VERIFY_RATE_LIMIT_WINDOW_SECONDS=600

# Email delivery (Resend) for password-reset and change-email-verification
# links. Optional at boot — the app still starts and every unrelated feature
# still works without these; only the two email-dependent flows above fail
# safely (a clear in-app error) instead of silently succeeding when unset.
# Never put a real API key here or in any committed file.
# RESEND_API_KEY=
# EMAIL_FROM=Academy Management SaaS <no-reply@example.com>
# APP_URL=http://localhost:3000

# Optional email-change verification token lifetime in minutes. Default: 60.
# EMAIL_CHANGE_TOKEN_TTL_MINUTES=60

# Optional email-change verification-request rate limit, keyed per
# requesting userId. Defaults: 5 attempts / 900 seconds.
# EMAIL_CHANGE_RATE_LIMIT_MAX_ATTEMPTS=5
# EMAIL_CHANGE_RATE_LIMIT_WINDOW_SECONDS=900

# Cloudflare R2 (S3-compatible) object storage — used for academy-uploaded
# files (first consumer: the academy logo, lib/academies/academy-logo.ts).
# Optional at boot — the app still starts and every unrelated feature still
# works without these; only R2-dependent flows fail safely (a clear in-app
# error) instead of silently succeeding when unset. The bucket must stay
# private (no public access) — the app only ever generates short-lived
# signed URLs. Never put real credentials here or in any committed file.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Optional email-OTP MFA login method (additional to TOTP). Code lifetime
# in minutes. Default: 10.
# MFA_EMAIL_OTP_TTL_MINUTES=10

# Optional "send/resend code to my email" rate limit, keyed per userId.
# Defaults: 5 attempts / 900 seconds.
# MFA_EMAIL_OTP_RATE_LIMIT_MAX_ATTEMPTS=5
# MFA_EMAIL_OTP_RATE_LIMIT_WINDOW_SECONDS=900

# Optional: credentials for `npm run seed`'s one demo platform_owner
# account (PLAN.md "Seed & Demonstration Data": demo credentials live only
# here/README, never hardcoded as if real). Defaults shown; the script
# refuses to run at all if NODE_ENV=production regardless of these values.
# SEED_PLATFORM_OWNER_EMAIL=owner@example.com
# SEED_PLATFORM_OWNER_PASSWORD=changeme-12345678

# Optional: credentials for the full demo academy dataset `npm run seed`
# also creates (Phase 5, Item 67 — one demo academy, 2 branches, one
# account per academy role, ~10 students, 2 batches with published
# results, a few payments/expenses, one certificate). Same
# never-a-real-secret convention as SEED_PLATFORM_OWNER_* above; the
# script refuses to run at all if NODE_ENV=production. One shared password
# applies to every demo academy account.
# SEED_DEMO_PASSWORD=DemoPassw0rd!2026
# SEED_DEMO_OWNER_EMAIL=demo-owner@example.com
# SEED_DEMO_ADMIN_EMAIL=demo-admin@example.com
# SEED_DEMO_MANAGER_EMAIL=demo-manager@example.com
# SEED_DEMO_ADMISSIONS_EMAIL=demo-admissions@example.com
# SEED_DEMO_FINANCE_EMAIL=demo-finance@example.com
# SEED_DEMO_TRAINER_EMAIL=demo-trainer@example.com
